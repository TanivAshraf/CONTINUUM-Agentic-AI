# ── Gemini / AI ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-pro

# ── WordPress ─────────────────────────────────────────────────────────────────
WP_URL=https://your-wordpress-site.com
WP_USER=your_wp_username
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
WP_DEFAULT_STATUS=publish
WP_POST_STATUS=publish

# ── Google OAuth (Photos + Gmail) ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_PHOTOS_REFRESH_TOKEN=your_photos_refresh_token
GOOGLE_PHOTOS_ALBUM_ID=AF1QipNV4MW6_c9WiJ7ugxSwmnUrqWxu_ZkJdg2r5Yc0
GMAIL_REFRESH_TOKEN=your_gmail_refresh_token

# ── Optional ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
RESEARCH_LOGS_DIR=research_logs
MEMORY_FILE=data/system_memory.json
